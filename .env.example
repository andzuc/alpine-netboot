# Interfaccia parent della MacVlan (opzionale, default intnet -> virt)
INTERFACE=lan0

# IP del server PXE
DNSMASQ_IP=192.168.101.105

# IP del router
ROUTER_IP=192.168.101.1

# Versione Alpine (es. 3.20.3)
ALPINE_VERSION=3.20.3

# Architettura (opzionale, default x86_64)
ARCH=x86

# MAC del target PXE (opzionale, qui esempio default per virt-n270)
PXE_MAC=52:54:00:01:01:01

# Console del target PXE (opzionale, default tty0)
PXE_CONSOLE=ttyS0,115200

# Nome della VM target PXE (opzionale, default virt-n270)
VM_TITLE='virt-arouter'
