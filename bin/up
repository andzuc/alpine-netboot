#!/bin/bash
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PATH="${PATH}:${MYDIR}"
cd "${MYDIR}/.."
[ -f .env ]&&source .env
set -e

docker compose --progress plain build
docker compose up -d

if [ "${INTERFACE-intnet}" = "intnet" ]; then
    export VM_NAME="${VM_TITLE}"
    export VM_MAC="${PXE_MAC}"
    cd virt-n270
    bin/up_virt
fi
