#!/bin/bash
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PATH="${PATH}:${MYDIR}"
cd "${MYDIR}/.."
[ -f .env ]&&source .env
set -e

if [ "${INTERFACE-intnet}" = "intnet" ]; then
    PROFILE="virt"
else
    export VM_TITLE="novm"
fi

docker compose --profile "${PROFILE}" --progress plain build
docker compose --profile "${PROFILE}" up --wait

if [ "${INTERFACE-intnet}" = "intnet" ]; then
    export VM_NAME="${VM_TITLE}"
    export VM_MAC="${PXE_MAC}"
    cd virt-n270
    bin/up_virt
fi

docker compose --profile "${PROFILE}" logs -f
