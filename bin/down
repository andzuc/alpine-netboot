#!/bin/bash
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PATH="${PATH}:${MYDIR}"
cd "${MYDIR}/.."
[ -f .env ]&&source .env
set -e

if [ "${INTERFACE-intnet}" = "intnet" ]; then
    export VM_TITLE
    export PXE_MAC
    cd virt-n270
    vagrant destroy -f
fi

docker compose down
