#!/bin/bash
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PATH="${PATH}:${MYDIR}"
cd "${MYDIR}/.."
[ -f .env ]&&source .env

if [ "${INTERFACE-intnet}" = "intnet" ]; then
    export VM_NAME="${PXE_HOSTNAME}"
    cd virt-n270
    bin/down_virt
    PROFILE="virt"
fi

docker compose --profile "${PROFILE}" down
